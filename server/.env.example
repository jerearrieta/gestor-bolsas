# Copiá este archivo como .env y completá con los datos de Supabase
# (Supabase > Project Settings > API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=tu-anon-o-publishable-key
# Dirección del front (para permitir CORS). Podés poner varias separadas por coma.
CLIENT_URL=http://localhost:5173
PORT=4000
